# EXAMPLE ONLY. Installer creates /opt/etc/nvr-v2.conf with actual RTSP credentials.
# NEVER publish the actual config or RTSP URLs from ps/logs.
NVR_MOUNT='/tmp/mnt/YOUR_DISK_UUID'
NVR_BASE_DIR='/tmp/mnt/YOUR_DISK_UUID/cctv'
RTSP_USER='YOUR_USER'
RTSP_PASS='YOUR_CAMERA_PASSWORD'
RTSP_IP='192.168.1.135'
NVR_CAMERAS='101 201 301'
NVR_STALE_SECONDS=720
NVR_GRACE_SECONDS=600
NVR_RETENTION_SECONDS=259200
NVR_DISK_WARN_PERCENT=75
NVR_DISK_CRIT_PERCENT=90
